```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Compiled files
*.o
*.obj
*.so
*.dll
*.exe
*.a
*.out

# Dependencies
.venv/
venv/
node_modules/

# Build directories
build/
dist/
target/

# Logs and temp files
*.log
*.tmp
*.swp

# Environment
.env
*.env.*

# Editors
.vscode/
.idea/

# Coverage
.coverage
coverage/
htmlcov/

# Python specific caches
.mypy_cache/
.pytest_cache/
```